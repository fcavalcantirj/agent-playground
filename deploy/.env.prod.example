# Template for deploy/.env.prod — copy and fill in real values.
# deploy/.env.prod itself is gitignored; this file is checked in.
#
# Loaded by compose via:
#   docker compose --env-file deploy/.env.prod -f deploy/docker-compose.prod.yml ... up -d
#
# Two consumers:
#   1. docker-compose.prod.yml substitutes ${POSTGRES_PASSWORD} and
#      ${AP_CHANNEL_MASTER_KEY} into api_server's environment block.
#   2. The same env_file is also mounted INTO the container (env_file: .env.prod)
#      so python code reads os.environ.AP_CHANNEL_MASTER_KEY directly.
#
# Generate POSTGRES_PASSWORD: openssl rand -hex 32
# Generate AP_CHANNEL_MASTER_KEY: openssl rand -base64 32  (32 bytes → 44 chars b64)

POSTGRES_PASSWORD=

# Phase 22-02: 32-byte base64 master key for channel credential encryption.
# MUST be set in production; dev (AP_ENV=dev) falls back to 32 zero bytes.
AP_CHANNEL_MASTER_KEY=

# Phase 22b-04: sysadmin bypass for event-stream auth (D-15).
# Per-laptop / per-deploy state; NEVER commit the real value.
# Generate: openssl rand -hex 32
AP_SYSADMIN_TOKEN=

# Phase 22c: Google OAuth. Register at https://console.cloud.google.com/apis/credentials
# Callback must match exactly (http://localhost:8000 for dev, https://... for prod).
AP_OAUTH_GOOGLE_CLIENT_ID=
AP_OAUTH_GOOGLE_CLIENT_SECRET=
AP_OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# Phase 22c: GitHub OAuth. Register at https://github.com/settings/developers (OAuth Apps → New).
# Scopes requested at authorize time: read:user user:email (needed for email when private).
# No test-users mode — any GitHub user can sign in once the app is registered.
AP_OAUTH_GITHUB_CLIENT_ID=
AP_OAUTH_GITHUB_CLIENT_SECRET=
AP_OAUTH_GITHUB_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback

# Phase 23 (D-23): Mobile native-SDK Google sign-in client IDs.
# Google Cloud Console issues SEPARATE client IDs per platform (Android, iOS) —
# both are different from AP_OAUTH_GOOGLE_CLIENT_ID (the web client).
# Comma-separated list; the mobile JWT verifier accepts tokens whose ``aud``
# claim matches any entry. NOT a credential — these IDs ship in the mobile
# app binary and are not secret. (GitHub mobile reuses the existing GitHub
# OAuth app per D-24; no separate env var needed there.)
# Example: AP_OAUTH_GOOGLE_MOBILE_CLIENT_IDS=123-android.apps.googleusercontent.com,456-ios.apps.googleusercontent.com
AP_OAUTH_GOOGLE_MOBILE_CLIENT_IDS=

# --- Phase 22c: Starlette SessionMiddleware signing secret ---
# authlib's OAuth flow stores the CSRF state token inside request.session
# (Starlette's built-in signed-cookie session). AP_OAUTH_STATE_SECRET is
# the signing key for the ap_oauth_state cookie (10-minute TTL; carries the
# state nonce between /v1/auth/<provider> authorize-redirect and
# /v1/auth/<provider>/callback).
#
# REQUIRED in production. In dev (AP_ENV=dev) the code falls back to a
# fixed dev-only placeholder so local tests boot without ops setup.
#
# Generate: openssl rand -hex 32
AP_OAUTH_STATE_SECRET=

# Phase 22c-09: post-OAuth redirect target. The API issues 302s to
# /dashboard and /login?error=... after the OAuth callback completes.
# Without this var the API falls back to http://localhost:3000 — fine
# for dev, BROKEN in prod (users would land on a dead URL after sign-in).
# Set this to the public-facing frontend origin (no trailing slash).
AP_FRONTEND_BASE_URL=http://localhost:3000

# --- Phase 28 — Temporal-backed message dispatch ---
# Internal Docker DNS hostnames; override only if running services elsewhere.
AP_TEMPORAL_HOST=temporal:7233
AP_TEMPORAL_NAMESPACE=default
AP_TEMPORAL_TASK_QUEUE=ap-messages
# Per-call bot HTTP timeout (seconds). forward_to_agent activity uses this
# + 30s buffer for its start_to_close timeout (D-12).
AP_BOT_TIMEOUT_SECONDS=60

# --- Phase B — Stripe Paywall (D-22, D-25) ---
# REQUIRED in prod; placeholders OK in dev (api_server emits a warning
# log per missing AP_STRIPE_* and substitutes a dev placeholder so the
# app still boots — see api_server/src/api_server/config.py).
#
# Get TEST keys from https://dashboard.stripe.com/test/apikeys
# LIVE keys from https://dashboard.stripe.com/apikeys (DO NOT commit;
# load via deploy secrets only)
#
# Pro monthly subscription price (Stripe Dashboard → Products → ap_pro_monthly)
# 5 credit packs — one Product + Price each (lookup keys ap_pack_*usd).
# See .planning/phases/B-stripe-paywall/STRIPE-TEST-CATALOG.md for the
# canonical TEST-mode catalog (account acct_1Rbog8IXnB0o3aa1).
AP_STRIPE_API_KEY=sk_test_REPLACE_ME
AP_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
AP_STRIPE_PRICE_ID_PRO_MONTHLY=price_REPLACE_ME
AP_STRIPE_PRICE_ID_PACK_5=price_REPLACE_ME
AP_STRIPE_PRICE_ID_PACK_10=price_REPLACE_ME
AP_STRIPE_PRICE_ID_PACK_25=price_REPLACE_ME
AP_STRIPE_PRICE_ID_PACK_50=price_REPLACE_ME
AP_STRIPE_PRICE_ID_PACK_100=price_REPLACE_ME

# --- Phase B-stripe-13: CI / e2e gate keys (D-22, D-25) ---
# Read ONLY by `make e2e-phase-b-stripe` and the GH workflow
# `.github/workflows/e2e-phase-b.yml`. SEPARATE from AP_STRIPE_API_KEY /
# AP_STRIPE_WEBHOOK_SECRET so the test gate cannot accidentally hit the
# runtime app's Stripe surface (defense-in-depth even though Stripe TEST
# mode is free). Used by automation only — not by the api_server runtime.
#
# In CI: set as repo secrets (Settings → Secrets and variables → Actions).
# Locally: export from a sourced .env.prod or a private local file.
AP_STRIPE_TEST_API_KEY=sk_test_REPLACE_ME
AP_STRIPE_TEST_WEBHOOK_SECRET=whsec_REPLACE_ME
