.env
.env.local
.env.*.local
# Phase 22-02: deploy/.env.prod holds live POSTGRES_PASSWORD,
# AP_CHANNEL_MASTER_KEY, AP_SYSADMIN_TOKEN, AP_OAUTH_GOOGLE_* secrets.
# Template lives in deploy/.env.prod.example.
deploy/.env.prod
deploy/.env.prod.*
!deploy/.env.prod.example

# Runtime state from Claude Code worktree isolation + scheduler
.claude/worktrees/
.claude/scheduled_tasks.lock

# AI-tool local state — every coding agent drops its own dotdir; ignore
# everything that isn't a known project dotdir. Keep .claude (Claude Code)
# and skills/ (Claude Code skill index) and explicit project dirs.
