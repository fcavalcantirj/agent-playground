.env
.env.local
.env.*.local
# Phase 22-02: deploy/.env.prod holds live POSTGRES_PASSWORD,
# AP_CHANNEL_MASTER_KEY, AP_SYSADMIN_TOKEN, AP_OAUTH_GOOGLE_* secrets.
# Template lives in deploy/.env.prod.example.
deploy/.env.prod
deploy/.env.prod.*
!deploy/.env.prod.example

# Runtime state from Claude Code worktree isolation + scheduler
.claude/worktrees/
.claude/scheduled_tasks.lock

# AI-tool local state — every coding agent drops its own dotdir; ignore
# everything that isn't a known project dotdir. Keep .claude (Claude Code)
# and skills/ (Claude Code skill index) and explicit project dirs.
.adal/
.agents/
.aider-desk/
.augment/
.bob/
.codeartsdoer/
.codebuddy/
.codemaker/
.codestudio/
.commandcode/
.continue/
.cortex/
.crush/
.devin/
.factory/
.forge/
.goose/
.hermes/
.iflow/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.openhands/
.pi/
.pochi/
.qoder/
.qwen/
.roo/
.rovodev/
.tabnine/
.trae/
.vibe/
.windsurf/
.zencoder/

# Python
__pycache__/
*.egg-info/
*.pyc
# Android signing secrets — local-only after 2026-05-11 leak rotation.
# Google flagged the SA JSON via GitHub secret-scanning even on private
# repos, so we now keep all credentials OUT of git. Only the public
# play_app_signing.der (X.509 cert) is committed for OAuth client registration.
# Build still works locally: key.properties + .jks + service-account.json
# live at mobile/keys/android/ on disk, just not tracked.
mobile/keys/android/play-service-account.json
mobile/keys/android/*.jks
mobile/android/key.properties

# Fastlane runtime artifacts (regenerated each run; not source).
mobile/android/metadata/
mobile/android/fastlane/report.xml
mobile/android/fastlane/README.md
mobile/ios/fastlane/report.xml
mobile/ios/fastlane/README.md

# iOS — App Store Connect API key for fastlane pilot upload.
# Generate at https://appstoreconnect.apple.com/access/integrations/api
# Download the .p8 ONCE; if leaked, revoke + reissue. Same posture as
# the Android SA JSON — kept on local disk only.
mobile/keys/ios/asc-api-key.json
mobile/keys/ios/*.p8
